# Kubernetes support layered on top of the storage kernel.
#
# This fragment is merged after configs/common.config, configs/virtio.config,
# and configs/storage.config, so the result still boots the same virtio-fs,
# virtio-net, and disk-backed LightVM images and additionally provides:
#   - HugeTLB pages, hugetlbfs, and the cgroup v2 hugetlb controller.
#     kubeadm's system verification reports "CGROUPS_HUGETLB: missing" without
#     CONFIG_CGROUP_HUGETLB, and the controller is how Kubernetes accounts for
#     hugepage-backed pods.
#   - The running kernel config at /proc/config.gz. kubeadm's kernel checks
#     parse this file; without it system-validators tries `modprobe configs`,
#     which fails because this kernel is built without loadable modules.
#   - kube-proxy IPVS mode and its schedulers, including SCTP.
#   - kube-proxy iptables-mode matches (SCTP, realm, statistic, rpfilter) and
#     SCTP connection tracking.
#   - ebtables, Geneve, IP-in-IP, and GRE for bridge/overlay CNI plugins, plus
#     the tc/eBPF hooks used by kube-proxy and eBPF-based CNIs.
#   - eBPF LSM programs: BPF_PROG_TYPE_LSM, active "bpf" LSM, and the vmlinux
#     BTF that userspace needs to resolve LSM hook IDs.
#
# All options are built in: the kernel is booted with an initramfs and does not
# load modules.

# Expose the running kernel config at /proc/config.gz. kubeadm's
# SystemVerification parses it for its kernel option checks. Without it,
# system-validators falls back to `modprobe configs`, which cannot work in a
# kernel built without CONFIG_MODULES and fails with "unable to load kernel
# module: configs". IKCONFIG_PROC requires IKCONFIG and PROC_FS.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# HugeTLB pages and the cgroup v2 hugetlb controller. CONFIG_HUGETLBFS selects
# CONFIG_HUGETLB_PAGE, but both are listed so the required-config check fails
# loudly if a future kernel changes that dependency. CONFIG_CGROUP_HUGETLB is
# what adds "hugetlb" to /sys/fs/cgroup/cgroup.controllers.
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_CGROUP_HUGETLB=y

# IPv6 is required for dual-stack clusters and for IPv6 IPVS services.
CONFIG_IPV6=y

# kube-proxy IPVS mode. The RR, WRR, and SH schedulers cover the schedulers
# Kubernetes exposes; NFCT exports IPVS connections to netfilter so policies
# and conntrack keep working. Without IP_VS the kube-proxy IPVS mode falls back
# to iptables with an error.
CONFIG_IP_VS=y
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_PROTO_SCTP=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y

# kube-proxy iptables mode. The common fragment already provides conntrack,
# NAT, multiport, and comment matching; these are the remaining matches used
# by kube-proxy's generated rules.
CONFIG_NETFILTER_XT_MATCH_SCTP=y
CONFIG_NETFILTER_XT_MATCH_REALM=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_NF_CT_PROTO_SCTP=y

# ebtables for bridge CNI plugins and for kube-proxy's bridge rules. The legacy
# ebtables tables are built in for compatibility with iptables-nft and older
# CNI versions.
CONFIG_BRIDGE_NF_EBTABLES=y
CONFIG_BRIDGE_EBT_BROUTE=y
CONFIG_BRIDGE_EBT_T_FILTER=y
CONFIG_BRIDGE_EBT_T_NAT=y

# CNI overlay transports. VXLAN is already enabled by common.config; Geneve,
# IP-in-IP, and GRE cover Calico, Cilium, and other common CNI modes.
CONFIG_GENEVE=y
CONFIG_NET_IPIP=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y

# tc/eBPF hooks used by kube-proxy and eBPF-based CNIs (Cilium, Calico eBPF).
# NET_SCHED is disabled by tinyconfig and is not pulled in by the other
# networking options.
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# eBPF LSM (BPF_PROG_TYPE_LSM). CONFIG_BPF_LSM depends on CONFIG_BPF_EVENTS,
# which in turn requires CONFIG_PERF_EVENTS and at least one of
# CONFIG_KPROBE_EVENTS/UPROBE_EVENTS. Both live under the FTRACE menu, so the
# k8s variant also overrides common.config's disabled FTRACE. Uprobe events are
# enough for the BPF_EVENTS dependency and avoid pulling in kprobes/KALLSYMS.
CONFIG_FTRACE=y
CONFIG_PERF_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y

# Security core and the LSM list. A built-in BPF LSM is compiled in only when
# CONFIG_BPF_LSM is set, but it is not initialized unless "bpf" is present in
# CONFIG_LSM. Capability is always the first LSM and does not need to be
# listed. The network and path hooks let BPF LSM programs attach to socket and
# pathname-based security hooks.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="yama,bpf"

# BTF. BPF LSM programs attach to security hooks by BTF ID, and libbpf/bpftool
# resolve those IDs from /sys/kernel/btf/vmlinux. Without vmlinux BTF the LSM
# is active but userspace cannot load programs for it. Generating BTF needs
# DWARF info and pahole; the builder image installs the dwarves package. This
# overrides common.config's DEBUG_INFO_NONE and is why the k8s kernel is larger
# than the virtio and storage variants.
CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_DEBUG_INFO_BTF=y
