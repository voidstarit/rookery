# Shared base for every Rookery LightVM kernel variant.
#
# The Makefile merges this fragment into a tinyconfig and then merges the
# fragments for the selected variant (see configs/virtio.config and
# configs/storage.config). Keep only options that every variant needs here;
# device- and feature-specific options belong in the variant fragment.
#
# Everything is built into the bzImage (CONFIG_MODULES stays off) because
# LightVM boots a kernel plus initramfs without a module tree.
# CONFIG_MODULES is not set

# Architecture and process basics
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
# POSIX clocks/timers (timer_create, clock_nanosleep, ...) and high-resolution
# timers are required by guest workloads and their init systems; tinyconfig
# disables both, and timerfd alone does not pull them in.
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
# System V IPC provides shmget(2)/shmat(2) shared memory, semaphores, and
# message queues. Several guest workloads (PostgreSQL, Oracle, some init
# scripts) still require SysV shared memory even when they could use POSIX
# shared memory, which only needs the already-enabled tmpfs.
CONFIG_SYSVIPC=y
# Container runtimes mount an mqueue filesystem at /dev/mqueue for each
# container's IPC namespace; without this the mount fails and containers
# cannot start with the default private IPC mode.
CONFIG_POSIX_MQUEUE=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y

# Namespaces and cgroup v2. Container runtimes and systemd need both; tinyconfig
# disables CONFIG_NAMESPACES, which also hides the per-namespace options, and
# CONFIG_CGROUPS, which hides every controller.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
# cgroup v2 controllers for service/container limits: cpu.weight/cpu.max,
# cpuset, memory.max, pids.max, and io.max/io.weight. The v1-only controllers
# (CGROUP_DEVICE, CGROUP_CPUACCT, CGROUP_FREEZER, CGROUP_NET_*, MEMCG_V1,
# CPUSETS_V1) stay disabled; cgroup v2 always provides freezer and cgroup
# namespaces when CGROUPS is enabled.
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_PSI=y

# Nested containers: eBPF for cgroup v2 device policies, seccomp/keyrings for
# sandboxing, and overlayfs for the overlay2/overlay storage drivers.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y
CONFIG_FANOTIFY=y
CONFIG_OVERLAY_FS=y

# Nested container networking: bridges and veth pairs for the default
# network, TUN for rootless slirp4netns, the common Docker/Podman link
# drivers, connection tracking/NAT, and both nftables and the legacy
# iptables stack (with x_tables compatibility for iptables-nft).
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_VLAN_8021Q=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y

# Required by LVM (flock on /run/lock/lvm/P_global) and by many userspace
# tools (apk, databases, package managers). Without it flock(2) returns ENOSYS.
CONFIG_FILE_LOCKING=y
# Async I/O: LVM uses Linux AIO (io_setup/io_submit) for device scanning;
# io_uring is used by QEMU, databases, and other guest workloads.
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEFAULT_HOSTNAME="lightvm"
CONFIG_LOCALVERSION="-lightvm"

# Initramfs and memory-backed filesystems (no on-disk filesystems)
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y

# Guest integration and ACPI poweroff
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_ACPI=y

# Networking (DHCP in the initramfs)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y

# Virtual terminals are required by images whose init/getty expects
# /dev/tty1..N. Keep the VGA console and input devices disabled; LightVM uses
# the virtio console (hvc0) for I/O.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# CONFIG_VGA_CONSOLE is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MOUSEDEV is not set

# Keep the image small: no debug, USB, sound, DRM, or real filesystems.
# The storage variant re-enables ext4 and XFS in configs/storage.config; the
# explicit "is not set" entries below keep the minimal virtio variant from
# picking them up through a Kconfig default.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KALLSYMS is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_SERIO is not set
# CONFIG_ACPI_BUTTON is not set
# CONFIG_HID is not set
# CONFIG_DRM is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
