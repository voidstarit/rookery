# Storage features layered on top of the virtio kernel.
#
# This fragment is merged after configs/common.config and configs/virtio.config,
# so the resulting kernel still boots the same virtio-fs/virtio-net LightVM
# images and additionally provides:
#   - LVM: device-mapper plus the dm-thin-pool target used by Rookery storage
#     backends (vgcreate/lvcreate and thin volumes).
#   - iSCSI initiator (open-iscsi/iscsiadm) and LIO target
#     (targetcli; configfs backstores).
#   - Network block device (nbd-client).
#   - Userspace block driver (ublk).
#
# All options are built in: the kernel is booted with an initramfs and does not
# load modules.

# LVM relies on device-mapper, which lives under the MD (multiple devices)
# menu. Thin pools need the dm-thin-pool target, which selects
# dm-persistent-data and dm-bufio.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y

# iSCSI initiator. ISCSI_TCP selects the SCSI iSCSI attribute helpers and the
# CRC/crypto hashes required by the protocol.
CONFIG_SCSI_ISCSI_ATTRS=y
CONFIG_ISCSI_TCP=y

# iSCSI target (LIO) with file and block backstores. TARGET_CORE selects
# configfs, SCSI common code, CRC_T10DIF, and SGL_ALLOC; configfs is listed
# explicitly because targetcli needs /sys/kernel/config.
CONFIG_TARGET_CORE=y
CONFIG_CONFIGFS_FS=y
CONFIG_TCM_FILEIO=y
CONFIG_TCM_IBLOCK=y
CONFIG_ISCSI_TARGET=y

# Network block device client.
CONFIG_BLK_DEV_NBD=y

# Userspace block driver (ublk). It is io_uring-based, so it depends on
# CONFIG_IO_URING from common.config. Keep it built in: the fast path relies
# on task_work_add(), which is not exported to modules. Legacy opcodes remain
# enabled for older ublk servers.
CONFIG_BLK_DEV_UBLK=y
CONFIG_BLKDEV_UBLK_LEGACY_OPCODES=y
