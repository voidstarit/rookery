#!/bin/sh
case "$1" in
	deconfig)
		# The persistent client in the switched root must not wipe the
		# address already configured by the initramfs.
		if [ "${ROOKERY_DHCP_RENEW:-0}" = 1 ]; then
			exit 0
		fi
		ip link set "$interface" up 2>/dev/null || true
		ip addr flush dev "$interface" 2>/dev/null || true
		;;
	bound|renew)
		ip link set "$interface" up 2>/dev/null || true
		ip addr flush dev "$interface" 2>/dev/null || true
		ip addr add "${ip}/${mask:-24}" dev "$interface"
		if [ -n "$router" ]; then
			for gateway in $router; do
				ip route add default via "$gateway" dev "$interface" 2>/dev/null || true
				break
			done
		fi
		{
			echo "# generated by udhcpc"
			for dns_server in $dns; do
				echo "nameserver $dns_server"
			done
		} > /etc/resolv.conf
		;;
esac
exit 0
